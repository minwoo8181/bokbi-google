{
  "name": "bokbi-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3006",
    "build": "next build",
    "start": "next start -p 3006",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "data:build": "node scripts/build-market-dataset.mjs",
    "data:info": "node scripts/build-complex-info.mjs",
    "data:asking": "node scripts/build-asking-prices.mjs",
    "units:fetch": "node --env-file=.env.local scripts/fetch-building-units.mjs",
    "analysis:report": "vite-node --config vitest.config.ts scripts/inspect-engine.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.3",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@opennextjs/cloudflare": "^1.20.13",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^4.152.0"
  }
}
